body {
background-image: url(https://web.uc-bcf.edu.ph/wp-content/uploads/2024/10/web-bg.jpg);
background-attachment: fixed;
background-repeat: no-repeat;
background-size: stretch;
background-color: rgb(83, 104, 99);
font-family: Arial, Helvetica, sans-serif;
}

.forms {
padding-top: 5%;
padding-bottom: 3%;
max-width: 500px;
border-radius: 30px;
padding-left: 5%;
padding-right: 5%;
padding-top: 5%;
padding-bottom: 3%;
}
.box {
img {
display: block;
margin-left: auto;
margin-right: auto;
width: 90%;
padding-top: 5%;
}
width: 50%;
background-color: rgb(190, 192, 189);
margin-left: auto;
margin-right: auto;
margin-top: 5%;
max-width: 500px;
border-radius: 10px;
box-shadow: 0px 10px 10px rgba(0, 0, 0, 0.5);
text-align: center;
}

input[type=text], input[type=email], select {
padding: 12px 20px;
border: none;
border-radius: 0 10px 10px 0;
margin-left: 20px;
}
.form-group {
color: white;
display: inline-block;
border: none;
padding-left: 30px;
border-radius: 10px;
background-color: #424242;
margin: 5px;
min-width: 200px;
}

input[type=submit] {
width: 100%;
background-color: #63a165;
color: white;
padding: 14px 20px;
margin: 8px 0;
border: none;
border-radius: 10px;
cursor: pointer;
transition: transform 0.3s ease, box-shadow 0.3s ease;
}
input[type=submit]:hover {
background-color: #4e7d4f;
transform: translateY(-5px) scale(1.0); /* Lifts up and grows slightly */
box-shadow: 0 5px 5px rgba(0, 0, 0, 0.2); /* Deepens the shadow */
}